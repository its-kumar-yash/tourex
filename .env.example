# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin tasks that bypass RLS (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Direct Postgres connection (Session pooler, port 5432) from Supabase → Connect.
# Server-only; used by npm run db:push / db:seed. Never shipped to the browser.
SUPABASE_DB_URL=
